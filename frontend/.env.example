# Base URL of the Django API as seen by the browser.
# "/api" goes through the Vite dev-server proxy (see vite.config.ts).
VITE_API_URL=/api

# Where the Vite dev server proxies /api and /media (not exposed to the browser).
# Local backend: http://localhost:8000, docker-compose: http://app:8000
API_PROXY_TARGET=http://localhost:8000
