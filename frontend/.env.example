# Base URL of the Django API as seen by the browser.
# "/api" goes through the Vite dev-server proxy (see vite.config.ts).
VITE_API_URL=/api

# Where the Vite dev server proxies /api and /media (not exposed to the browser).
# Local backend: http://localhost:8000, docker-compose: http://app:8000
API_PROXY_TARGET=http://localhost:8000

# Google OAuth client id ("Sign in with Google"); same value as backend GOOGLE_CLIENT_ID.
# Empty → the Google button is hidden. In docker-compose it is taken from the root .env.
# Google Cloud Console → OAuth client → Authorized JavaScript origins must include
# http://localhost:5173
VITE_GOOGLE_CLIENT_ID=
